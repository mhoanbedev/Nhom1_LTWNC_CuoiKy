# Sao chép thành .env bằng `make env` (tự bổ sung biến mới vào .env có sẵn).
# Không commit .env.

# --- App ---
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# --- Docker dev: PostgreSQL ---
# Cổng 5435 trên máy, vì 5432–5434 đã có Postgres khác trên máy dùng.
POSTGRES_USER=ltwnc
POSTGRES_PASSWORD=ltwnc
POSTGRES_DB=ltwnc
POSTGRES_PORT=5435

# --- Database (app kết nối) ---
DATABASE_URL=postgresql://ltwnc:ltwnc@localhost:5435/ltwnc

# --- Auth ---
# Để trống: `make env` tự sinh chuỗi ngẫu nhiên cho dev. Production đặt giá trị riêng trên Render.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_TOKEN_GRACE_SECONDS=30
# Giới hạn tần suất: request/phút trên một IP cho route auth công khai; số lần đăng nhập/15 phút cho một email.
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_LOGIN_PER_EMAIL=10

# --- Google OAuth ---
# Client ID không phải bí mật (nằm sẵn trong mọi id_token), cả nhóm dùng chung client này.
# Client secret chỉ frontend (Auth.js) cần, KHÔNG đặt ở đây.
GOOGLE_CLIENT_ID=791262062854-3o24jj2b41b2idjtt1j1vp5o00eljreu.apps.googleusercontent.com

# --- Cloudinary (ảnh công khai, CV riêng tư) ---
# Lấy ở Cloudinary Dashboard / Settings → API Keys. API secret là bí mật, chỉ điền trong .env.
# Nhớ bật Settings → Security → "Allow delivery of PDF and ZIP files" để tải được CV.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Seed (`make seed`) ---
# Tài khoản admin duy nhất của hệ thống. Giá trị demo; khi seed Neon (production) đặt mật khẩu khác.
SEED_ADMIN_EMAIL=admin@demo.vn
SEED_ADMIN_PASSWORD=Demo@2026
