# Sao chép thành .env bằng `make env` (tự bổ sung biến mới vào .env có sẵn).
# Không commit .env.

# --- App ---
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# --- Docker dev: PostgreSQL ---
# Cổng 5434 trên máy, vì 5432 thường bị PostgreSQL cài sẵn chiếm.
POSTGRES_USER=ltwnc
POSTGRES_PASSWORD=ltwnc
POSTGRES_DB=ltwnc
POSTGRES_PORT=5434

# --- Database (app kết nối) ---
DATABASE_URL=postgresql://ltwnc:ltwnc@localhost:5434/ltwnc
