{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Node20: chuẩn cho app CommonJS chạy trên Node 20+ (thay Node10 đã deprecated từ TS 6), cho phép
    // require gói chỉ có ESM (vd @faker-js/faker) như Node 24 hỗ trợ;
    // package.json không có "type": "module" nên vẫn build ra CommonJS như cũ.
    "module": "Node20",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "types": ["node", "jest"]
  },
  "include": ["src", "test"],
  "ts-node": {
    // TypeORM CLI chạy migration qua ts-node; bỏ type-check cho nhanh (typecheck đã có script riêng).
    "transpileOnly": true
  }
}
